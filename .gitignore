venv/
__pycache__/
*.pyc
.DS_Store
data/eval_data/
data/eval_results/
data/speech-datasets/
data/static_assets/
captionlm.egg-info/

# read-aloud eval: the .wav and the extracted term lists ARE tracked, so a
# fresh clone can reproduce the read-aloud numbers without a manual file
# transfer. The source video is not -- it is large and the .wav is derived
# from it.
data/read_aloud/*.m4a
data/read_aloud/*.mp3
data/read_aloud/*.mp4

# user drop-off: keep the README, ignore everything dropped in
dropoff/*
!dropoff/README.md
